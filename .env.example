# Every setting can be set as HTH_<NAME>; lists and objects as JSON.
HTH_QUOTE_CURRENCY=USDC  # USDC, USDT or EUR
HTH_BAR=4H  # 1H, 2H, 4H, 6H, 12H or 1D
# HTH_PAIRS='["BTC-USDC","ETH-USDC","SOL-USDC"]'
HTH_MAX_PAIRS=20
HTH_ENTER_THRESHOLD=70
HTH_WAIT_THRESHOLD=40
HTH_CAPITAL=10000
HTH_RISK_PER_TRADE_PCT=1
HTH_FEE_PCT=0.10
HTH_SLIPPAGE_PCT=0.05
HTH_REQUIRE_VALIDATION=true
# Marked open positions, used to signal SALIR:
# HTH_POSITIONS='[{"pair":"SOL-USDC","entry_price":180.5,"entry_time":"2026-11-01T12:00:00Z"}]'
# Trading from Telegram (off by default). Use OKX demo-trading keys first.
HTH_TRADING_ENABLED=false
HTH_OKX_DEMO=true
# HTH_OKX_API_KEY=
# HTH_OKX_API_SECRET=
# HTH_OKX_PASSPHRASE=
HTH_MAX_ORDER_AMOUNT=500
HTH_STOP_LOSS_ON_EXCHANGE=true
# Bitácora OKX (ha-trading-helper journal serve). Read-only key; EEA accounts use eea.okx.com.
# HTH_OKX_DOMAIN=eea.okx.com
# HTH_DB_HOST=  # empty = SQLite in HTH_DATA_DIR; MariaDB: host, HTH_DB_USER, HTH_DB_PASSWORD
# HTH_TIMEZONE=Europe/Madrid
HTH_MQTT_HOST=localhost
HTH_MQTT_PORT=1883
HTH_DATA_DIR=.data
HTH_LOG_LEVEL=INFO
